@model API_CitasMedicas.Models.Cita
@{
    ViewData["Title"] = "Agendar Cita";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-info text-white">
            <h2 class="mb-0">Agendar Nueva Cita</h2>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div class="mb-3">
                    <label class="form-label">Fecha y Hora</label>
                    @* Cambiado de Fecha a FechaHora *@
                    <input asp-for="FechaHora" type="datetime-local" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">ID Médico</label>
                    @* Cambiado de MedicoId a IdMedico *@
                    <input asp-for="IdMedico" class="form-control" type="number" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">ID Paciente</label>
                    @* Cambiado de PacienteId a IdPaciente *@
                    <input asp-for="IdPaciente" class="form-control" type="number" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Motivo de la Cita</label>
                    @* Agregamos Motivo porque está en tu modelo *@
                    <input asp-for="Motivo" class="form-control" placeholder="Ej: Control general" required />
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Regresar</a>
                    <button type="submit" class="btn btn-info">Agendar Cita</button>
                </div>
            </form>
        </div>
    </div>
</div>