@model List<API_CitasMedicas.Models.Paciente>

<div class="container mt-4">
    <h2>Listado de Pacientes</h2>
    <hr />
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <span>➕</span> Registrar Nuevo Paciente
        </a>
    </div>
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Fecha Nacimiento</th>
                <th>Teléfono</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Nombre</td>
                    <td>@item.FechaNacimiento.ToShortDateString()</td>
                    <td>@item.Telefono</td>
                    <td>
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>