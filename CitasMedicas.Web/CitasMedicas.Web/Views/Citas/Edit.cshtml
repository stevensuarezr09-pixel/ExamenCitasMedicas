@model API_CitasMedicas.Models.Cita
<div class="container mt-4">
    <h2>Reagendar Cita</h2>
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label>Nueva Fecha y Hora</label>
            <input asp-for="FechaHora" type="datetime-local" class="form-control" />
        </div>
        <div class="mb-3">
            <label>Motivo</label>
            <input asp-for="Motivo" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Confirmar Cambio</button>
    </form>
</div>