@model API_CitasMedicas.Models.Medico
@{
    ViewData["Title"] = "Nuevo Médico";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Registrar Nuevo Médico</h2>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div class="mb-3">
                    <label class="form-label">Nombre Completo</label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Dr. Juan Pérez" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Especialidad</label>
                    <input asp-for="Especialidad" class="form-control" placeholder="Ej: Cardiología" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Correo Electrónico</label>
                    <input asp-for="Correo" type="email" class="form-control" placeholder="medico@ejemplo.com" required />
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Regresar</a>
                    <button type="submit" class="btn btn-primary">Guardar Médico</button>
                </div>
            </form>
        </div>
    </div>
</div>