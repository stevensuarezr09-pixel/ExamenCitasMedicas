@model API_CitasMedicas.Models.Paciente
@{
    ViewData["Title"] = "Nuevo Paciente";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h2 class="mb-0">Registrar Nuevo Paciente</h2>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div class="mb-3">
                    <label class="form-label">Nombre Completo</label>
                    <input asp-for="Nombre" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Teléfono</label>
                    @* Usamos Telefono porque es lo que tienes en el modelo *@
                    <input asp-for="Telefono" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Fecha de Nacimiento</label>
                    <input asp-for="FechaNacimiento" type="date" class="form-control" required />
                </div>
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Regresar</a>
                    <button type="submit" class="btn btn-success">Guardar Paciente</button>
                </div>
            </form>
        </div>
    </div>
</div>