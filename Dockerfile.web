FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# 1. Copiamos ABSOLUTAMENTE TODO el repositorio
COPY . .

# 2. Restauramos usando una búsqueda automática para no fallar con las rutas
RUN dotnet restore $(find . -name "CitasMedicas.Web.csproj")

# 3. Compilamos y Publicamos la Web
RUN dotnet publish $(find . -name "CitasMedicas.Web.csproj") -c Release -o /app/publish

# 4. Imagen final de ejecución
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/publish .

# Asegúrate que el nombre de la DLL coincida con tu proyecto
ENTRYPOINT ["dotnet", "CitasMedicas.Web.dll"]
