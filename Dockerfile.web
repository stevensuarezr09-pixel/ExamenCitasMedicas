FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /app

# 1. Copiamos todo el contenido
COPY . .

# 2. Publicamos ignorando las referencias a otros proyectos que falten
# Esto evita el error de "Project reference does not exist"
RUN dotnet publish $(find . -name "CitasMedicas.Web.csproj") \
    -c Release \
    -o out \
    /p:ValidateExecutableReferences=false \
    /p:IgnoreProjectReferences=true

# 3. Imagen de ejecución
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/out .

# 4. Ajuste de puerto para Render
ENV ASPNETCORE_URLS=http://+:80
EXPOSE 80

ENTRYPOINT ["dotnet", "CitasMedicas.Web.dll"]
