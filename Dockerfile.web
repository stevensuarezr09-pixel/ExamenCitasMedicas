FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# 1. Copiamos todo el contenido del repositorio
COPY . .

# 2. Restauramos las dependencias buscando los proyectos manualmente
# Esto evita el error del archivo .slnx
RUN dotnet restore "CitasMedicas.Web/CitasMedicas.Web/CitasMedicas.Web.csproj"

# 3. Publicamos la Web
# El compilador encontrará la API porque está en la carpeta de al lado (/src/API_CitasMedicas)
RUN dotnet publish "CitasMedicas.Web/CitasMedicas.Web/CitasMedicas.Web.csproj" -c Release -o /app/publish

# 4. Imagen final de ejecución
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/publish .

# Asegúrate de que el nombre de la DLL sea este
ENTRYPOINT ["dotnet", "CitasMedicas.Web.dll"]
