@model List<API_CitasMedicas.Models.Medico>

@{
    ViewData["Title"] = "Listado de Médicos";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <hr />
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <span>➕</span> Registrar Nuevo Médico
        </a>
    </div>
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Especialidad</th>
                <th>Correo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var medico in Model)
            {
                <tr>
                    <td>@medico.Id</td>
                    <td>@medico.Nombre</td>
                    <td>@medico.Especialidad</td>
                    <td>@medico.Correo</td>
                    <td>
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@medico.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@medico.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>