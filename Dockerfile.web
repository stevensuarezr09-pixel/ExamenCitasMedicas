FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# 1. Copiamos TODO el repositorio (API y Web)
COPY . .

# 2. Comando especial para arreglar las referencias de carpetas
# Esto hace que la Web encuentre a la API sin importar los "../../"
RUN dotnet restore $(find . -name "CitasMedicas.Web.csproj")

# 3. Publicamos la Web
RUN dotnet publish $(find . -name "CitasMedicas.Web.csproj") -c Release -o /app/publish

# 4. Imagen final
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "CitasMedicas.Web.dll"]
